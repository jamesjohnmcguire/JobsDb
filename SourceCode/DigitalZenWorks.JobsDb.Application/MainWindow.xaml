<Window x:Class="DigitalZenWorks.JobsDb.Application.MainWindow"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Jobs DB" Height="650" Width="1100"
	MinHeight="450" MinWidth="800">
	<DockPanel Margin="16"
		Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
		<StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
			<TextBlock Text="Job Listings" FontSize="24"
				FontWeight="SemiBold" Margin="0,0,0,8" />
			<Button Content="Reload Jobs" HorizontalAlignment="Left"
				Padding="12,6" IsEnabled="{Binding CanLoad}"
				Click="ReloadJobs_Click" />
		</StackPanel>
		<StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
			<TextBlock x:Name="StatusText" Text="{Binding StatusMessage}"
				TextWrapping="Wrap" />
		</StatusBar>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="3*" />
				<RowDefinition Height="8" />
				<RowDefinition Height="2*" />
			</Grid.RowDefinitions>
			<DataGrid x:Name="JobsGrid" Grid.Row="0"
				ItemsSource="{Binding Jobs}"
				SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
				AutoGenerateColumns="False" IsReadOnly="True"
				CanUserAddRows="False" CanUserDeleteRows="False"
				SelectionMode="Single" SelectionUnit="FullRow">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Title"
						Binding="{Binding Title}" Width="2*" />
					<DataGridTextColumn Header="Company"
						Binding="{Binding Company}" Width="*" />
					<DataGridTextColumn Header="Location"
						Binding="{Binding Location}" Width="*" />
					<DataGridTextColumn Header="Source"
						Binding="{Binding Source}" Width="Auto" />
					<DataGridTextColumn Header="Posted"
						Binding="{Binding DatePosted, StringFormat=d}"
						Width="Auto" />
					<DataGridTextColumn Header="Status"
						Binding="{Binding Status}" Width="Auto" />
				</DataGrid.Columns>
			</DataGrid>
			<GridSplitter Grid.Row="1" Height="4"
				HorizontalAlignment="Stretch" />
			<GroupBox Grid.Row="2" Header="Selected Job" Padding="8">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
						FontWeight="SemiBold"
						Text="{Binding SelectedJob.Title}" />
					<TextBox x:Name="JobDescription"
						Text="{Binding SelectedJob.Description, Mode=OneWay}"
						IsReadOnly="True" TextWrapping="Wrap"
						VerticalScrollBarVisibility="Auto" />
				</DockPanel>
			</GroupBox>
		</Grid>
	</DockPanel>
</Window>
