<Window x:Class="DigitalZenWorks.JobsDb.Application.MainWindow"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="clr-namespace:DigitalZenWorks.JobsDb.Library.Models;assembly=DigitalZenWorks.JobsDb.Library"
	Title="Jobs DB" Height="760" Width="1240"
	MinHeight="500" MinWidth="800">
	<DockPanel
		Background="{DynamicResource WindowBackground}">
		<DockPanel.Resources>
			<Style x:Key="PriorityButton" TargetType="Button">
				<Setter Property="Width" Value="26" />
				<Setter Property="Height" Value="26" />
				<Setter Property="Margin" Value="2,1" />
				<Setter Property="IsEnabled"
					Value="{Binding DataContext.CanEditPriority,
						RelativeSource={RelativeSource
						AncestorType=DataGrid}}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Grid x:Name="PriorityFace"
								Background="Transparent">
								<Ellipse x:Name="PriorityCircle"
									Fill="{TemplateBinding Background}"
									StrokeThickness="0"
									Stroke="{TemplateBinding Foreground}" />
								<ContentPresenter x:Name="PriorityLetter"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="Tag" Value="Selected">
									<Setter TargetName="PriorityLetter"
										Property="TextElement.FontWeight"
										Value="Bold" />
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="PriorityFace"
										Property="Opacity" Value="0.85" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused"
									Value="True">
									<Setter TargetName="PriorityCircle"
										Property="StrokeThickness" Value="2" />
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="PriorityFace"
										Property="Opacity" Value="0.55" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger Property="Tag" Value="Selected">
						<Setter Property="Foreground" Value="#17202A" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="HighPriorityButton" TargetType="Button"
				BasedOn="{StaticResource PriorityButton}">
				<Setter Property="Background" Value="#234C77" />
				<Setter Property="Foreground" Value="#C3E0FF" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Priority}" Value="5">
						<Setter Property="Tag" Value="Selected" />
						<Setter Property="Background" Value="#329BFF" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Priority}" Value="4">
						<Setter Property="Tag" Value="Selected" />
						<Setter Property="Background" Value="#329BFF" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="MediumPriorityButton" TargetType="Button"
				BasedOn="{StaticResource PriorityButton}">
				<Setter Property="Background" Value="#235C3B" />
				<Setter Property="Foreground" Value="#C0F0CE" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Priority}" Value="3">
						<Setter Property="Tag" Value="Selected" />
						<Setter Property="Background" Value="#32D66E" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="LowPriorityButton" TargetType="Button"
				BasedOn="{StaticResource PriorityButton}">
				<Setter Property="Background" Value="#6A531B" />
				<Setter Property="Foreground" Value="#FFF0AE" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Priority}" Value="1">
						<Setter Property="Tag" Value="Selected" />
						<Setter Property="Background" Value="#FFD32A" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Priority}" Value="2">
						<Setter Property="Tag" Value="Selected" />
						<Setter Property="Background" Value="#FFD32A" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<DataTemplate x:Key="AppliedCell">
				<Button x:Name="AppliedToggle" Click="Applied_Click"
					Padding="6,0"
					HorizontalAlignment="Center" FontWeight="Bold">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="AppliedFace" Background="Transparent"
								BorderThickness="1" BorderBrush="Transparent"
								CornerRadius="4"
								Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="AppliedFace"
										Property="Background"
										Value="{DynamicResource
											ControlFillColorSecondaryBrush}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused"
									Value="True">
									<Setter TargetName="AppliedFace"
										Property="BorderBrush"
										Value="{DynamicResource
											ControlStrongStrokeColorDefaultBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>

					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Content" Value="&#x2713;" />
							<Setter Property="Foreground" Value="#299357" />
							<Setter Property="ToolTip" Value="Applied" />
							<Setter Property="AutomationProperties.Name"
								Value="Applied" />
							<Setter Property="IsEnabled" Value="False" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Status}"
									Value="{x:Static
										models:ApplicationStatus.Applied}">
									<Setter Property="ToolTip"
										Value="Clear applied mark" />
									<Setter Property="AutomationProperties.Name"
										Value="Clear applied mark" />
									<Setter Property="IsEnabled"
										Value="{Binding DataContext.CanEditApplied,
											RelativeSource={RelativeSource
											AncestorType=DataGrid}}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Status}"
									Value="{x:Static
										models:ApplicationStatus.NotApplied}">
									<Setter Property="Content"
										Value="&#x2717;" />
									<Setter Property="Foreground"
										Value="#CD434A" />
									<Setter Property="ToolTip"
										Value="Mark as applied" />
									<Setter Property="AutomationProperties.Name"
										Value="Mark as applied" />
									<Setter Property="IsEnabled"
										Value="{Binding DataContext.CanEditApplied,
											RelativeSource={RelativeSource
											AncestorType=DataGrid}}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</DataTemplate>

			<DataTemplate x:Key="PriorityCell">
				<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Center">
					<Button x:Name="HighPriority" Content="A"
						ToolTip="High priority"
						AutomationProperties.Name="A, high priority"
						Style="{StaticResource HighPriorityButton}"
						CommandParameter="{x:Static models:JobPriority.High}"
						Click="Priority_Click" />
					<Button x:Name="MediumPriority" Content="B"
						ToolTip="Medium priority"
						AutomationProperties.Name="B, medium priority"
						Style="{StaticResource MediumPriorityButton}"
						CommandParameter="{x:Static models:JobPriority.Medium}"
						Click="Priority_Click" />
					<Button x:Name="LowPriority" Content="C"
						ToolTip="Low priority"
						AutomationProperties.Name="C, low priority"
						Style="{StaticResource LowPriorityButton}"
						CommandParameter="{x:Static models:JobPriority.Low}"
						Click="Priority_Click" />
				</StackPanel>
			</DataTemplate>
		</DockPanel.Resources>
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock x:Name="StatusText" Text="{Binding StatusMessage}"
					TextWrapping="Wrap" />
			</StatusBarItem>
		</StatusBar>
		<Grid Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="4*" MinHeight="120" />
				<RowDefinition Height="8" />
				<RowDefinition Height="2*" MinHeight="180" />
			</Grid.RowDefinitions>
			<DockPanel Margin="0,0,0,12">
				<Button DockPanel.Dock="Right" Content="Reload Jobs"
					Padding="12,6" IsEnabled="{Binding CanLoad}"
					Click="ReloadJobs_Click" />
				<Button x:Name="ImportEmailsButton" DockPanel.Dock="Right"
					Content="Import Emails" Margin="0,0,8,0" Padding="12,6"
					IsEnabled="{Binding CanLoad}" Click="ImportEmails_Click" />
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
					Margin="0,0,12,0" VerticalAlignment="Center">
					<TextBlock Text="Theme" VerticalAlignment="Center"
						Margin="0,0,6,0" />
					<ComboBox x:Name="ThemeSelector" SelectedValuePath="Content"
						MinWidth="92" AutomationProperties.Name="Theme">
						<ComboBoxItem Content="System" />
						<ComboBoxItem Content="Light" />
						<ComboBoxItem Content="Dark" />
					</ComboBox>
				</StackPanel>
				<TextBlock Text="Job Listings" FontSize="22"
					FontWeight="SemiBold" VerticalAlignment="Center" />
			</DockPanel>
			<TabControl x:Name="ReviewTabs" Grid.Row="1" Margin="0,0,0,4"
				SelectedIndex="{Binding SelectedReviewTab, Mode=TwoWay}">
				<TabControl.Resources>
					<SolidColorBrush x:Key="TabViewSelectedItemBorderBrush"
						Color="{DynamicResource ControlStrongStrokeColorDefault}" />
				</TabControl.Resources>
				<TabItem Header="Inbox" Margin="0,0,3,0"
					BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
				<TabItem Header="Reviewed"
					BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
			</TabControl>
			<DataGrid x:Name="JobsGrid" Grid.Row="2"
				ItemsSource="{Binding VisibleJobs}"
				SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
				AutoGenerateColumns="False" IsReadOnly="True"
				CanUserAddRows="False" CanUserDeleteRows="False"
				SelectionMode="Single" SelectionUnit="FullRow"
				HeadersVisibility="Column" MinRowHeight="26">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Title"
						Binding="{Binding Title}" Width="2*">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock" BasedOn="{x:Static
								DataGridTextColumn.DefaultElementStyle}">
								<Setter Property="TextTrimming"
									Value="CharacterEllipsis" />
								<Setter Property="ToolTip"
									Value="{Binding Title}" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>
					<DataGridTextColumn Header="Company"
						Binding="{Binding Company}" Width="*" />
					<DataGridTextColumn Header="Location"
						Binding="{Binding Location}" Width="*" />
					<DataGridTextColumn Header="Source"
						Binding="{Binding Source}" Width="Auto" />
					<DataGridTextColumn Header="Posted"
						Binding="{Binding DatePosted, StringFormat=d}"
						Width="Auto" />
					<DataGridTemplateColumn Header="Applied" Width="Auto"
						SortMemberPath="Status"
						CellTemplate="{StaticResource AppliedCell}" />
					<DataGridTemplateColumn Header="Priority" Width="108"
						CellTemplate="{StaticResource PriorityCell}" />
				</DataGrid.Columns>
			</DataGrid>
			<GridSplitter Grid.Row="3" Height="4"
				HorizontalAlignment="Stretch" ResizeDirection="Rows"
				ResizeBehavior="PreviousAndNext" />
			<GroupBox Grid.Row="4" Header="Selected Job" Padding="8">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
						FontWeight="SemiBold"
						Text="{Binding SelectedJob.Title}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
						ToolTip="{Binding SelectedJob.SourceUrl}"
						TextTrimming="CharacterEllipsis">
						<Hyperlink x:Name="PostingAddressLink"
							Foreground="{DynamicResource
								AccentTextFillColorPrimaryBrush}"
							IsEnabled="{Binding CanOpenPosting}"
							Click="OpenPosting_Click">
							<Run Text="{Binding SelectedJob.SourceUrl,
								Mode=OneWay}" />
						</Hyperlink>
					</TextBlock>
					<RichTextBox x:Name="JobDescription" IsReadOnly="True"
						IsDocumentEnabled="True"
						VerticalScrollBarVisibility="Auto">
						<FlowDocument PagePadding="0"
							FontFamily="{Binding FontFamily,
								ElementName=JobDescription}"
							FontSize="{Binding FontSize,
								ElementName=JobDescription}">
							<Paragraph x:Name="DescriptionParagraph"
								Margin="0" />
						</FlowDocument>
					</RichTextBox>
				</DockPanel>
			</GroupBox>
		</Grid>
	</DockPanel>
</Window>
