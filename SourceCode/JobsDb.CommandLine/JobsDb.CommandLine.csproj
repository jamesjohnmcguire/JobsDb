<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>jobsdb</AssemblyName>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="StyleCop.Analyzers" Version="1.4.26-beta">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="../DigitalZenWorks.JobsDb.Library/DigitalZenWorks.JobsDb.Library.csproj" />
		<ProjectReference
			Include="../LoggingFoundation/LoggingService/LoggingService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="JobsDbTests" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="../stylecop.json" />
	</ItemGroup>

</Project>
